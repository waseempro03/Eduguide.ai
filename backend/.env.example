# ==============================================================================
# EduGuide AI — Environment Configuration
# ==============================================================================

# Server Port (Default: 5001 to prevent macOS AirPlay port 5000 conflict)
PORT=5001

# Google Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Key (Alternative)
# If left blank, the application gracefully operates using Google Gemini or the built-in local NLP engine
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# MongoDB Connection String (Local MongoDB or MongoDB Atlas cloud connection URI)
# If left blank or unreachable, the application runs in dual-mode using seeded local JSON storage
MONGODB_URI=mongodb://localhost:27017/eduguide_ai

# Client URL (For CORS whitelist)
CLIENT_URL=http://localhost:3000
